{
  "appId": "com.begau.trithuc",
  "appName": "Bé Gấu Tri Thức",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#7ec8e3",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#7ec8e3",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#7ec8e3"
    }
  },
  "server": {
    "androidScheme": "https"
  }
}
